# App
PORT=3000
APP_URL="http://localhost:3000"

# Postgres (Neon)
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# REQUIRED in production — at least 32 random characters
# Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Account login (email + password)
SOLO_EMAIL="you@example.com"
# REQUIRED in production — at least 12 characters (not "outreach")
SOLO_PASSWORD="replace-with-a-strong-password"

# Optional — password reset emails (Resend). Without this, reset links only log in development.
RESEND_API_KEY=""
EMAIL_FROM="Outreach <onboarding@resend.dev>"

# Gemini AI Studio API key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Local / Vercel — use a Postgres URL (Neon free tier works for both)
# Example Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# Session signing (generate a long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Solo login password
SOLO_PASSWORD="outreach"

# Gemini AI Studio API key
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

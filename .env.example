# Local SQLite (default). For Postgres later: postgresql://...
DATABASE_URL="file:./dev.db"

# Session signing (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Solo login PIN / password for first-run setup
SOLO_PASSWORD="outreach"

# Gemini AI Studio API key (Flash free tier works)
GEMINI_API_KEY=""
# Optional: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro etc.
GEMINI_MODEL="gemini-2.0-flash"
